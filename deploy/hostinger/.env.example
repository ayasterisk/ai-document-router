# SoNNMT Document Router — cấu hình cho Hostinger (backend thật app.main:app)
# Copy thành /opt/document-ai/.env, điền token thật.

# ---------- Xác thực client (Tampermonkey) ----------
# JSON: {"principal":"token"} — mỗi tài khoản tích hợp 1 token riêng, >= 32 ký tự.
ROUTER_API_KEYS={"vanthu01":"REPLACE_WITH_RANDOM_TOKEN"}

# Origin thật của website Sở (để CORS cho Tampermonkey). Không dùng "*".
ROUTER_ALLOWED_ORIGINS=["https://vpdt.gialai.gov.vn"]

# ---------- Giới hạn ----------
ROUTER_MAX_UPLOAD_BYTES=20971520
ROUTER_MAX_TEXT_CHARS=200000
ROUTER_MAX_PAGES=50
ROUTER_MAX_FILES=5
ROUTER_MAX_WORKERS=2
ROUTER_MAX_PENDING=8
ROUTER_JOB_TIMEOUT=300
ROUTER_RETENTION_DAYS=30

# ---------- Model định tuyến (qua SSH tunnel ngược tới Ollama) ----------
# Tunnel ngược đưa Ollama của container về loopback Hostinger cổng 11434.
HARNESS_TOOL_MODE=auto
INFERENCE_SERVER_URL=http://127.0.0.1:11434
INFERENCE_MODEL=qwen3-vl:8b
INFERENCE_API_KEY=EMPTY
INFERENCE_TOOL_CALLING=true
INFERENCE_TIMEOUT=60
INFERENCE_RETRY=0
INFERENCE_MAX_TOOL_STEPS=3

# ---------- OCR bản scan (dùng chung Ollama, cùng model VL) ----------
OCR_PROVIDER=qwen-vl
OCR_SERVER_URL=http://127.0.0.1:11434
OCR_MODEL=qwen3-vl:8b
OCR_API_KEY=EMPTY
OCR_PAGE_DPI=160
OCR_MAX_TOKENS=2048
OCR_TIMEOUT=120
