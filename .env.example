# Endpoint inference server local (vLLM/TGI) — bỏ trống để dùng mock (dev)
INFERENCE_SERVER_URL=

# auto | native | prompt | off
HARNESS_TOOL_MODE=auto

# Giới hạn vòng lặp / retry / timeout (giây)
HARNESS_MAX_TOOL_STEPS=6
HARNESS_RETRY=2
HARNESS_MODEL_TIMEOUT=60

# ===== OCR bản scan — Qwen2.5-VL-7B-Instruct qua vLLM (RTX 4090) =====
# auto | qwen-vl | tesseract | none
OCR_PROVIDER=auto
# Endpoint vLLM OpenAI-compatible của VLM (vd http://127.0.0.1:8001)
OCR_SERVER_URL=
OCR_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
OCR_API_KEY=EMPTY
# Độ phân giải rasterize trang PDF (DPI); cao hơn = OCR rõ hơn nhưng tốn VRAM/token
OCR_PAGE_DPI=200
# Token tối đa mỗi trang trả về
OCR_MAX_TOKENS=8192
# Context window cho VLM (ảnh trang A4 ~4k token, cần > 4096)
OCR_NUM_CTX=16384
OCR_TIMEOUT=120
