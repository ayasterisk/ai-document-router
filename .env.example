# SoNNMT API — copy to .env and replace the token before starting.
ROUTER_API_KEYS={"vanthu01":"REPLACE_WITH_RANDOM_TOKEN"}
# Exact origin of the existing department interface, e.g. https://vanban.example.vn
ROUTER_ALLOWED_ORIGINS=[]
ROUTER_MAX_UPLOAD_BYTES=20971520
ROUTER_MAX_TEXT_CHARS=200000
ROUTER_MAX_PAGES=50
ROUTER_MAX_FILES=5
ROUTER_MAX_WORKERS=2
ROUTER_MAX_PENDING=8
ROUTER_JOB_TIMEOUT=300
ROUTER_RETENTION_DAYS=30
# ROUTER_DB_PATH=C:/router-data/audit.db

# No model configured => deterministic rules + manual review; never an implicit mock.
HARNESS_TOOL_MODE=off
INFERENCE_SERVER_URL=
INFERENCE_MODEL=default
INFERENCE_API_KEY=EMPTY
INFERENCE_TOOL_CALLING=true
# Giới hạn cho model định tuyến/tóm tắt (fallback T1/T2) để trường hợp "không ra luật" không bị treo lâu:
INFERENCE_TIMEOUT=30        # giây cho mỗi lần gọi model (mặc định 60)
INFERENCE_RETRY=0           # 0 = không thử lại (nhanh nhất); 1 = thử lại 1 lần
INFERENCE_MAX_TOOL_STEPS=3  # số vòng tool-call tối đa ở T2

# none | auto | qwen-vl | tesseract. Configure an approved internal OCR service.
# OCR chỉ là "trích chữ", KHÔNG cần model lớn: dùng VLM 3B/7B là đủ và nhanh (20B rất chậm cho OCR).
OCR_PROVIDER=none
OCR_SERVER_URL=
OCR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct #Use Qwen/Qwen2.5-VL-7B-Instruct when up hosting
OCR_API_KEY=EMPTY
OCR_PAGE_DPI=160
OCR_MAX_TOKENS=2048          # 1 trang văn bản hiếm khi quá ~1500 token
OCR_TIMEOUT=30
