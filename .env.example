# =====================================================================
# Cấu hình server AI local — AI Document Router
# Core model: deepseek-reasoner (mặc định)
# =====================================================================

# --- DeepSeek API (OpenAI-compatible) ---
# Lấy key tại https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Có thể trỏ sang endpoint OpenAI-compatible khác (vd server local
# LM Studio / vLLM đang serve deepseek-r1) để chạy hoàn toàn offline:
# DEEPSEEK_BASE_URL=http://127.0.0.1:1234/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Core model — mặc định deepseek-reasoner (DeepSeek R1).
# Có thể đổi sang deepseek-chat để nhanh hơn/rẻ hơn khi cần.
DEEPSEEK_MODEL=deepseek-reasoner

# Giới hạn output tokens (reasoner cần nhiều token cho phần suy luận)
DEEPSEEK_MAX_TOKENS=8192

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Điều khiển hành vi harness ---
# Ngưỡng confidence để chốt kết quả rule engine (không cần gọi LLM)
RULE_CONFIDENCE_HIGH=0.80
# Dưới ngưỡng này → gọi deepseek-reasoner suy luận từ đầu
RULE_CONFIDENCE_LOW=0.50
# Cho phép gọi LLM khi rule mờ (False → luôn chạy rule engine thuần)
ALLOW_LLM=1

# --- Audit ---
AUDIT_DB_PATH=app/storage/audit.db
